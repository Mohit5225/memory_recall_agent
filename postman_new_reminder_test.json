{
  "info": {
    "name": "NEW Reminder End-to-End Test",
    "description": "Create a new reminder with topic, tone, and time ~10 minutes from now for complete validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create NEW Reminder (10 mins from now)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_id\": \"user_test_new_{{$timestamp}}\",\n    \"message\": \"Create a daily reminder about Python FastAPI development tips at {{current_time_plus_10}} with a professional and motivating tone. Make it concise and actionable.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chat",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1", 
            "chat"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Calculate current time + 10 minutes",
              "const now = new Date();",
              "const tenMinutesLater = new Date(now.getTime() + 10 * 60 * 1000);",
              "",
              "// Format as time (e.g., \"14:30\")",
              "const hours = tenMinutesLater.getHours().toString().padStart(2, '0');",
              "const minutes = tenMinutesLater.getMinutes().toString().padStart(2, '0');",
              "const timeString = `${hours}:${minutes}`;",
              "",
              "console.log(`Setting reminder time to: ${timeString} (10 minutes from now)`);",
              "pm.environment.set('current_time_plus_10', timeString);",
              "",
              "// Also set a readable timestamp for user_id",
              "const timestamp = Math.floor(Date.now() / 1000);",
              "pm.environment.set('timestamp', timestamp);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains success', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('response');",
              "});",
              "",
              "// Extract and save user_id for DB checking",
              "const requestBody = JSON.parse(pm.request.body.raw);",
              "const userId = requestBody.user_id.replace('{{$timestamp}}', pm.environment.get('timestamp'));",
              "console.log(`\\n🔍 USER ID FOR DB CHECK: ${userId}`);",
              "console.log(`⏰ REMINDER SET FOR: ${pm.environment.get('current_time_plus_10')}`);",
              "console.log(`\\n📋 NEXT STEPS:`);",
              "console.log(`1. Check MongoDB for user_id: ${userId}`);", 
              "console.log(`2. Verify config is set with FastAPI topic and professional tone`);",
              "console.log(`3. Check schedules collection for new schedule`);",
              "console.log(`4. Monitor Celery logs in next 10 minutes for LLM calls and reminder dispatch`);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Alternative: Specific Time Reminder",
      "request": {
        "method": "POST", 
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_id\": \"user_manual_test_{{$timestamp}}\",\n    \"message\": \"Set a reminder for 14:30 today about Machine Learning study session with an encouraging and detailed tone\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/chat",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "chat"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const requestBody = JSON.parse(pm.request.body.raw);", 
              "const userId = requestBody.user_id.replace('{{$timestamp}}', pm.environment.get('timestamp'));",
              "console.log(`\\n🔍 USER ID FOR DB CHECK: ${userId}`);",
              "console.log(`⏰ REMINDER SET FOR: 14:30 today`);",
              "console.log(`📋 Check DB and monitor Celery logs!`);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ]
}
